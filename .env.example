# Copy to .env or .env.local, then set real values.
# Vercel: Project → Settings → Environment Variables (match Production for local DB + auth).

# MongoDB (required) — same cluster as production if you want the same data
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority"

# Server JWT (required) — must be at least 32 characters
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional (see lib/env-validation.ts)
# NODE_ENV=development
# JWT_EXPIRY=7d
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_STORAGE_SECRET=optional-32-chars-when-you-use-encrypted-client-storage
# ALLOWED_ORIGINS=
# LOG_LEVEL=info
